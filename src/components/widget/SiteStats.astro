---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import {
    getCategoryList,
    getSortedPosts,
    getTagList,
} from "@/utils/content-utils";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
    class?: string;
    style?: string;
}

const { class: className, style } = Astro.props;

// 从配置中获取站点开始日期
const siteStartDate = siteConfig.siteStartDate || "2025-01-01";
// 获取所有文章
const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();
// 计算总字数
let totalWords = 0;
for (const post of posts) {
    if (post.body) {
        // 移除 Markdown 空白字符后计算字数
        const text = post.body
            .replace(/\s+/g, " ") // 合并空白
            .trim();
        // 分别计算中文字符和英文单词
        const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || [];
        const englishWords = text.match(/[a-zA-Z]+/g) || [];

        totalWords += chineseChars.length + englishWords.length;
    }
}

// 格式化数字（添加千位分隔符）
function formatNumber(num: number): string {
    return num.toLocaleString();
}

// Keep the widget aligned with the post ordering logic.
const activityTimestamps = posts.map(post => {
    return (post.data.updated ?? post.data.published).getTime();
});

const finalLastActivityTime = activityTimestamps.length > 0 
    ? Math.max(...activityTimestamps) 
    : null;

const lastPostDate = finalLastActivityTime 
    ? new Date(finalLastActivityTime).toISOString() 
    : null;

const todayText = i18n(I18nKey.today);
const stats = [
    {
        icon: "material-symbols:article-outline",
        label: i18n(I18nKey.siteStatsPostCount),
        value: posts.length,
    },
    {
        icon: "material-symbols:folder-outline",
        label: i18n(I18nKey.siteStatsCategoryCount),
        value: categories.length,
    },
    {
        icon: "material-symbols:label-outline",
        label: i18n(I18nKey.siteStatsTagCount),
        value: tags.length,
    },
    {
        icon: "material-symbols:text-ad-outline-rounded",
        label: i18n(I18nKey.siteStatsTotalWords),
        value: totalWords,
        formatted: true,
    },
    {
        icon: "material-symbols:calendar-clock-outline",
        label: i18n(I18nKey.siteStatsRunningDays),
        value: 0, // 将由客户端更新
        suffix: i18n(I18nKey.siteStatsDays).replace("{days}", ""),
        dynamic: true,
        id: "running-days",
    },
    {
        icon: "material-symbols:ecg-heart-outline",
        label: i18n(I18nKey.siteStatsLastUpdate),
        value: 0, // 将由客户端更新
        suffix: i18n(I18nKey.siteStatsDaysAgo).replace("{days}", ""),
        dynamic: true,
        id: "last-update",
    },
];
---

<WidgetLayout name={i18n(I18nKey.siteStats)} id="site-stats" class={className} style={style}>
  <div class="flex flex-col gap-2">
    {stats.map((stat) => (
      <div class="flex items-center justify-between px-3 py-1.5">
        <div class="flex items-center gap-2.5">
          <div class="text-[var(--primary)] text-xl">
            <Icon name={stat.icon} />
          </div>
          <span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">
            {stat.label}
          </span>
        </div>
        <div class="flex items-center">
          <span
            class="text-base font-bold text-neutral-900 dark:text-neutral-100"
            data-stat-id={stat.id}
          >
            {stat.formatted ? formatNumber(stat.value) : stat.value}
          </span>
          {stat.suffix && (
            <span class="text-sm text-neutral-500 dark:text-neutral-400 ml-1">
              {stat.suffix}
            </span>
          )}
        </div>
      </div>
    ))}

    {/* 访客数组件 (修复版) */}
    <div class="flex items-center justify-between px-3 py-1.5">
        <div class="flex items-center gap-2.5">
            <div class="text-[var(--primary)] text-xl">
                <Icon name="material-symbols:group-outline" />
            </div>
            <span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">
                访客数
            </span>
        </div>
        <div class="flex items-center">
            <span class="text-base font-bold text-neutral-900 dark:text-neutral-100">
                {/* 注意：这里把 id 改为了 sidebar_stats_uv，避免和页脚冲突。
                   数据将通过下面的脚本从页脚“镜像”过来。
                */}
                <span id="sidebar_stats_uv">--</span>
            </span>
            <span class="text-sm text-neutral-500 dark:text-neutral-400 ml-1">人</span>
        </div>
    </div>

  </div>
</WidgetLayout>

<script is:inline define:vars={{ siteStartDate, lastPostDate, todayText }}>
  // 使用封装函数避免全局冲突
  (function() {
    function updateStats() {
      const today = new Date();
      const startDate = new Date(siteStartDate);
      const diffDays = Math.ceil(Math.abs(today - startDate) / (1000 * 60 * 60 * 24));
      const el = document.querySelector('[data-stat-id="running-days"]');
      if (el) el.textContent = diffDays;

      if (lastPostDate) {
        const lastUpdate = document.querySelector('[data-stat-id="last-update"]');
        if (lastUpdate) {
          const days = Math.floor(Math.abs(today - new Date(lastPostDate)) / (1000 * 60 * 60 * 24));
          lastUpdate.textContent = days === 0 ? todayText : days;
          if (lastUpdate.nextElementSibling) lastUpdate.nextElementSibling.style.display = days === 0 ? 'none' : '';
        }
      }
    }

    function syncBusuanzi() {
      const src = document.getElementById('busuanzi_value_site_uv');
      const target = document.getElementById('sidebar_stats_uv');
      if (src && target && src.innerText !== '--' && src.innerText.trim() !== '') {
        target.innerText = src.innerText;
        return true;
      }
      return false;
    }

    updateStats();
    // 强力同步计时器
    const timer = setInterval(() => {
      if (syncBusuanzi()) clearInterval(timer);
    }, 1500);

    document.addEventListener("astro:page-load", () => {
      updateStats();
      syncBusuanzi();
    });
  })();
</script>
